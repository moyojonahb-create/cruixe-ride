<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      SCHEDULE_EXACT_ALARM is merged in by @capacitor/local-notifications, which
      declares it so apps can schedule notifications for a future time. We only
      ever deliver immediately (arrival announcements, ride offers), so we have
      no use case to declare — and Google Play requires a policy justification
      for it. Carrying an unjustifiable permission is worse than not having it.

      DO NOT REMOVE THIS REMOVAL. A future plugin update or a new plugin will
      pull the permission back in silently; this line is what keeps it out.

      NOTE: this fails at RUNTIME, not build time. A tools:node="remove" builds
      cleanly and then throws SecurityException at the call site if anything
      actually reaches AlarmManager. S9 (arrival notification on a locked
      screen) is the test that proves the removal is safe.

      USE_EXACT_ALARM — the stricter sibling Play restricts to alarm-clock and
      calendar apps — is verified absent, and must stay absent.
    -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:node="remove" />


    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Permission for camera (driver selfie + document upload) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Permission for microphone (Agora in-app calls) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Permissions for location -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- required left unset here defaults to true, which filters the Play
         listing off every device without GPS hardware (e.g. some tablets,
         Wi-Fi-only devices) that could otherwise still use coarse/network
         location for pickup. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- Permissions for contacts -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Required on Android 13+ (API 33) for any notification to show at
         all, including a driver's incoming-ride alert. Requested at runtime
         wherever the app wires up push/local notifications — declaring it
         here only makes the request legal, it doesn't grant it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
