+.approved-ride { --ride-red: #f10808; --ride-shadow: 0 4px 14px rgb(20 20 30 / 9%); color: #111; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
+.approved-ride .ride-map-control, .approved-ride .ride-map-controls > button { width: 50px !important; height: 50px !important; background: #fff !important; box-shadow: 0 7px 18px rgb(30 20 20 / 16%) !important; }
+.approved-ride .ride-map-control { top: calc(env(safe-area-inset-top) + 18px) !important; left: 20px; }
+.approved-ride .ride-map-controls { top: calc(env(safe-area-inset-top) + 18px) !important; right: 20px; gap: 8px; }
+.approved-ride .ride-map-control svg, .approved-ride .ride-map-controls > button > svg { width: 23px; height: 23px; color: #111; }
+.approved-ride .ride-booking-sheet { left: 0; right: 0; border-radius: 28px 28px 0 0 !important; filter: drop-shadow(0 -3px 10px rgb(30 20 20 / 8%)); }
+.ride-sheet-curve { position: absolute; inset: 0 0 auto; width: 100%; height: 30px; }
+.ride-booking-sheet > div:last-child { padding-bottom: max(14px, env(safe-area-inset-bottom)); }
+.ride-booking-sheet .ride-location-row { padding: 0 14px 8px; min-height: 40px; }
+.approved-ride .ride-town-pill, .approved-ride .ride-area-pill { background: #fff !important; box-shadow: var(--ride-shadow) !important; height: 34px !important; padding: 0 14px !important; max-width: 58%; }
+.ride-town-pill span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.ride-booking-sheet .ride-town-pill svg { width: 16px; height: 16px; flex-shrink: 0; }
+.ride-booking-sheet .ride-town-pill svg:first-child { color: var(--ride-red) !important; }
+.ride-booking-sheet .ride-town-pill span, .ride-booking-sheet .ride-area-pill span { font-size: 13px !important; font-weight: 650 !important; }
+.ride-booking-sheet--home .ride-sheet-scroll { flex: none; padding: 0 14px 8px !important; }
+.ride-home-tiles { height: 64px; gap: 7px; }
+.approved-ride .ride-destination-card { height: 100% !important; padding: 5px 7px 5px 4px !important; border-radius: 18px; background: #fff !important; box-shadow: var(--ride-shadow) !important; gap: 4px; }
+.ride-destination-card img { width: clamp(45px, 17vw, 70px) !important; height: 54px !important; }
+.ride-destination-card p:first-child { font-size: 11px !important; line-height: 1.2; color: #777 !important; }
+.ride-destination-card p:last-child { font-size: clamp(16px, 4.7vw, 21px) !important; white-space: nowrap; letter-spacing: -.7px !important; }
+.ride-destination-card > span { width: 35px !important; height: 35px !important; background: #f2f2f2 !important; border: 1px solid #e7e7e7; }
+.ride-destination-card > span svg { color: #111 !important; width: 19px; height: 19px; }
+.approved-ride .ride-shortcut { width: 60px !important; height: 100% !important; border-radius: 17px; box-shadow: var(--ride-shadow) !important; gap: 4px; }
+.approved-ride .ride-shortcut--home { background: #fff3f3 !important; border: 1px solid #ffe4e4; }
+.approved-ride .ride-shortcut--work { background: #fff9d9 !important; border: 1px solid #f5e8ac; }
+.ride-shortcut svg { width: 23px; height: 23px; color: var(--ride-red) !important; }
+.ride-shortcut--work svg { color: #b85800 !important; }
+.ride-shortcut span { font-size: 12px !important; }
+.ride-booking-sheet--home .ride-sheet-actions { padding: 0 14px 4px !important; }
+.ride-home-actions { gap: 8px; }
+.approved-ride .ride-schedule, .approved-ride .ride-start { height: 58px !important; border-radius: 18px !important; box-shadow: var(--ride-shadow) !important; }
+.ride-schedule { background: #fff !important; flex: .85; }
+.ride-schedule svg { width: 22px !important; height: 22px !important; color: var(--ride-red) !important; }
+.ride-schedule span { font-size: 16px !important; letter-spacing: -.5px; }
+.ride-start { background: linear-gradient(135deg, #ff563b 0%, #ff1010 50%, #e90000 100%) !important; }
+.ride-start > span:nth-child(2) { font-size: 19px !important; font-weight: 700; letter-spacing: -.5px; }
+.ride-start > span:last-child { width: 38px !important; height: 38px !important; background: rgb(170 0 0 / 32%) !important; box-shadow: inset 0 0 0 1px rgb(140 0 0 / 20%) !important; }
+.ride-start > span:last-child svg { width: 23px !important; height: 23px !important; }
+.approved-ride button:focus-visible { outline: 3px solid #222; outline-offset: 3px; }
