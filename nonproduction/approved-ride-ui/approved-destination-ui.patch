+    await act(async () => { await vi.advanceTimersByTimeAsync(200); });
+    expect(result.current.error).toMatch(/unavailable/i);
+    db.response = { data: [{ id: 'real-response', name: 'Provider result' }], error: null };
+    rerender({ retryKey: 1 });
